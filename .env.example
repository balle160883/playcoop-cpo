# Para conexiones externas desde internet se usa DB_HOST=31.97.144.6 y DB_PORT=5441
DB_HOST=playcoop-playcoop-wt3ftv
DB_PORT=5432
DB_NAME=playcoop-cpo
DB_USER=cpo-dev1
